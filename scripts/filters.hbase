# ======================================================================
# filters.hbase  --  Part 9: HBase Filters
# ----------------------------------------------------------------------
# Run with:  hbase shell filters.hbase
#
# Six filter techniques (the specification requires at least three), each
# tied to a real Network Operations question. Expected counts assume the
# clean 500-record load.
#
# A note on what a filter IS, because it drives every cost claim below:
# a filter is a server-side predicate. The RegionServer still reads every
# row in the scan range off disk and evaluates the predicate there, then
# ships only survivors to the client. Filters reduce NETWORK traffic and
# client-side work. They do not reduce DISK I/O. Only a bounded row-key
# range does that.
# ======================================================================


# ======================================================================
# FILTER 1 -- PrefixFilter
# ----------------------------------------------------------------------
# Business purpose : "Show me every event generated by wireless
#                     infrastructure in Ottawa unit 019."
# Filter           : PrefixFilter('WLS-OTT-019#')
# Expected result  : 15 rows.
# Explanation      : PrefixFilter matches on the ROW KEY, so it aligns
#                    with how the data is physically laid out. It is the
#                    most natural filter for this schema because DeviceID
#                    leads the key.
# ======================================================================
scan 'network_events', {FILTER => "PrefixFilter('WLS-OTT-019#')"}
count 'network_events', {FILTER => "PrefixFilter('WLS-OTT-019#')"}

# Broader prefix: every wireless device in the fleet. Expected: 86 rows.
count 'network_events', {FILTER => "PrefixFilter('WLS-')"}

# ---- IMPORTANT CAVEAT, worth a sentence in the demo -------------------
# PrefixFilter is NOT the same as a bounded scan. Without STARTROW the
# scanner begins at the first row of the table and walks ALL 500 rows,
# discarding non-matching ones. The result is identical; the plan is not.
# Compare these two, which return the same 15 rows:
#
#   (slow)  scan 'network_events', {FILTER => "PrefixFilter('WLS-OTT-019#')"}
#   (fast)  scan 'network_events', {STARTROW => 'WLS-OTT-019#', STOPROW => 'WLS-OTT-019$'}
#
# Best of both -- give the filter a starting point so it can also stop early:
scan 'network_events', {STARTROW => 'WLS-OTT-019#', FILTER => "PrefixFilter('WLS-OTT-019#')"}


# ======================================================================
# FILTER 2 -- SingleColumnValueFilter
# ----------------------------------------------------------------------
# Business purpose : "Which devices have reported a Critical event?"
#                    (Business Objective 6.)
# Filter           : SingleColumnValueFilter('event','severity',=,'binary:Critical')
# Expected result  : 96 rows.
# Explanation      : Compares one named column's value on every row.
#                    'binary:' selects BinaryComparator -- exact byte
#                    equality. Alternatives are 'substring:', 'regexstring:'
#                    and 'binaryprefix:'.
# ======================================================================
scan 'network_events', {FILTER => "SingleColumnValueFilter('event','severity',=,'binary:Critical')", COLUMNS => ['device:id','event:type','event:timestamp']}
count 'network_events', {FILTER => "SingleColumnValueFilter('event','severity',=,'binary:Critical')"}

# ---- filterIfColumnMissing (6-argument form) --------------------------
# By default SingleColumnValueFilter EMITS a row that lacks the tested
# column. In a sparse NoSQL table that silently corrupts the result set.
# The 5th argument forces such rows to be dropped; the 6th restricts the
# test to the latest cell version. Always prefer this form in production.
count 'network_events', {FILTER => "SingleColumnValueFilter('event','severity',=,'binary:Critical',true,true)"}


# ======================================================================
# FILTER 3 -- ValueFilter
# ----------------------------------------------------------------------
# Business purpose : "Find every cell anywhere in the record that mentions
#                     a connectivity interruption -- I do not know which
#                     column the operator typed it into."
# Filter           : ValueFilter(=,'substring:connectivity')
# Expected result  : ~100 CELLS (50 event:description + 50 event:type
#                    'ConnectivityLoss'), spread across 50 rows.
# Explanation      : ValueFilter is CELL-level, not row-level. It returns
#                    individual matching cells regardless of family or
#                    qualifier, so the output is partial rows. Useful for
#                    exploratory triage; a poor fit for reporting, because
#                    the caller gets fragments rather than whole records.
# ======================================================================
scan 'network_events', {FILTER => "ValueFilter(=,'substring:connectivity')", LIMIT => 10}

# Case matters with substring -- 'ConnectivityLoss' vs 'connectivity
# interrupted'. Two searches, two different cell sets:
count 'network_events', {FILTER => "ValueFilter(=,'substring:ConnectivityLoss')"}
count 'network_events', {FILTER => "ValueFilter(=,'substring:Critical')"}


# ======================================================================
# FILTER 4 -- ColumnPrefixFilter
# ----------------------------------------------------------------------
# Business purpose : "Build the error-code frequency report. I need the
#                     error_code column and nothing else -- do not ship me
#                     500 descriptions."
# Filter           : ColumnPrefixFilter('err')
# Expected result  : 500 cells, one per event (event:error_code).
# Explanation      : Selects columns whose QUALIFIER starts with a prefix.
#                    This is a projection filter: it trims the width of
#                    each row, cutting the bytes crossing the network.
#                    Combined with the 'event' family restriction below,
#                    HBase reads only the event family's HFiles -- one of
#                    the few filters that genuinely reduces disk I/O,
#                    because column families are stored separately.
# ======================================================================
scan 'network_events', {COLUMNS => 'event', FILTER => "ColumnPrefixFilter('err')", LIMIT => 20}
count 'network_events', {FILTER => "ColumnPrefixFilter('err')"}

# Two qualifiers at once (MultipleColumnPrefixFilter):
scan 'network_events', {FILTER => "MultipleColumnPrefixFilter('err','sev')", LIMIT => 10}


# ======================================================================
# FILTER 5 -- RowFilter with RegexStringComparator
# ----------------------------------------------------------------------
# Business purpose : "Every event from any device in Ottawa, whatever its
#                     type -- the site naming convention embeds the city
#                     code in the middle of the DeviceID."
# Filter           : RowFilter(=,'regexstring:^[A-Z]+-OTT-')
# Expected result  : 90 rows.
# Explanation      : The city code sits in the MIDDLE of the row key, so
#                    no prefix and no key range can reach it -- a prefix
#                    can only anchor at the left edge. A regex over the
#                    row key is the only key-based option, and it costs a
#                    full scan plus regex evaluation per row.
#
#                    This is the schema's blind spot made visible: the
#                    key is optimised for device lookups, so a site-level
#                    question degrades to the slowest access path in the
#                    file. Compare with the equivalent value filter --
#                    same 90 rows, and neither one is cheap.
# ======================================================================
scan 'network_events', {FILTER => "RowFilter(=,'regexstring:^[A-Z]+-OTT-')", COLUMNS => ['device:id','location:city','event:severity'], LIMIT => 15}
count 'network_events', {FILTER => "RowFilter(=,'regexstring:^[A-Z]+-OTT-')"}
count 'network_events', {FILTER => "SingleColumnValueFilter('location','city',=,'binary:Ottawa')"}

# RowFilter also does straight comparisons, e.g. a specific EventID
# wherever it lives -- the operator knows the ticket number but not the
# device. This is the query the alternative row key (EventID alone) would
# have made an O(1) get; here it is O(N). Part 4 discusses that trade.
scan 'network_events', {FILTER => "RowFilter(=,'substring:EVT-000018')"}


# ======================================================================
# FILTER 6 -- FilterList (composition) + PageFilter
# ----------------------------------------------------------------------
# Business purpose : "Give me the first page of the Critical-and-still-Open
#                     triage queue for the Eastern region."
# Filters          : SingleColumnValueFilter x3 combined with AND,
#                    plus PageFilter for pagination.
# Explanation      : The shell's filter language builds a FilterList with
#                    MUST_PASS_ALL. Predicate order matters: HBase
#                    evaluates left to right and short-circuits, so the
#                    most selective predicate should come first (Critical
#                    = 96 rows is more selective than Eastern = 192).
#
#                    PageFilter caps rows per RegionServer, so on a
#                    multi-region table it can return more rows than
#                    requested. LIMIT is the client-side cap and is what
#                    you actually want for a UI page.
# ======================================================================
scan 'network_events', {FILTER => "SingleColumnValueFilter('event','severity',=,'binary:Critical') AND SingleColumnValueFilter('status','state',=,'binary:Open') AND SingleColumnValueFilter('location','region',=,'binary:Eastern')", COLUMNS => ['device:id','event:type','event:timestamp','location:city']}

# Paginated form.
scan 'network_events', {FILTER => "SingleColumnValueFilter('event','severity',=,'binary:Critical') AND PageFilter(10)", COLUMNS => ['device:id','event:timestamp']}

# KeyOnlyFilter + FirstKeyOnlyFilter: return ONE zero-length cell per row.
# The cheapest possible way to count or to inspect key layout, because
# no values cross the network at all.
scan 'network_events', {FILTER => "KeyOnlyFilter() AND FirstKeyOnlyFilter()", LIMIT => 25}


# ======================================================================
# WHY FILTERING A FULL SCAN != DESIGNING THE RIGHT ROW KEY
# ----------------------------------------------------------------------
# Both return correct answers. They differ in where the work happens.
#
#   Row-key range     HBase consults the .META. table, identifies the one
#   (STARTROW/        region holding the range, seeks straight to the
#    STOPROW)         first matching block, and stops at STOPROW. Rows
#                     outside the range are never read, never
#                     deserialised, never evaluated. Work is proportional
#                     to the ANSWER size.
#
#   Filter on an      Every region is contacted. Every row in every region
#   unbounded scan    is read off disk, deserialised, and tested. Non-
#                     matching rows are discarded server-side. Work is
#                     proportional to the TABLE size, no matter how small
#                     the answer is.
#
# At 500 rows both feel instant and the distinction looks academic. At the
# volume this prototype is meant to model -- a national carrier emitting
# millions of events per day -- the difference is a sub-10ms lookup versus
# a multi-minute full-table read that saturates every RegionServer and
# degrades the write path for live event ingestion at the same time.
#
# The practical rule: a filter is a fallback for questions the row key was
# not designed to answer. If a filtered query becomes a primary access
# pattern, that is a signal to change the schema -- add a secondary index
# table, or maintain a second table with a different row key -- rather
# than to keep paying for the scan. Denormalising into multiple tables,
# each keyed for one access pattern, is idiomatic HBase, not a workaround.
# ======================================================================

exit
